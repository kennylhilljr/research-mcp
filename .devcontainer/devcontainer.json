{
  "name": "sdd-framework",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "npm install && npm install -g @anthropic-ai/claude-code && node tools/sdd/cli.mjs doctor",
  "customizations": {
    "vscode": {
      "extensions": ["bierner.markdown-mermaid", "vitest.explorer", "editorconfig.editorconfig"]
    }
  }
}
