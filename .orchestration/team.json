{
  "schema_version": "2.0",
  "merge_approval": "agents",
  "handoff_repair_turns": 1,
  "preflight": "required",
  "share_cap": 0.4,
  "personas": {
    "coder": "implementer",
    "pr_reviewer": "verifier",
    "security_reviewer": "security-reviewer",
    "verifier": "verifier",
    "architect": "architect",
    "product_owner": "product-writer",
    "steward": "doc-steward"
  },
  "roles": {
    "pr_reviewer": {
      "panels": {
        "economical": [
          "claude"
        ],
        "standard": [
          "claude"
        ],
        "advanced": [
          "claude"
        ]
      }
    },
    "security_reviewer": {
      "panel": [
        "claude"
      ]
    },
    "architect": {
      "contract_paths": [
        "src/research_mcp/core/specs.py",
        "src/research_mcp/core/models.py",
        "src/research_mcp/sources/base.py",
        "src/research_mcp/platform/migrations/**"
      ],
      "panel": [
        "claude"
      ]
    },
    "designer": {
      "when_paths": [
        "src/research_mcp/ui/**"
      ],
      "panel": [
        "claude"
      ]
    },
    "delivery_lead": {
      "class": "standard",
      "panel": [
        "claude"
      ]
    },
    "product_owner": {
      "panel": [
        "claude"
      ]
    },
    "verifier": {
      "panel": [
        "claude"
      ]
    }
  },
  "milestone": {
    "name": "M0",
    "docs": [
      {
        "path": "docs/build/M0-plan-v1.md",
        "sections": [
          "1",
          "2"
        ]
      },
      {
        "path": "docs/prd/PRD-v7.md",
        "sections": [
          "1.4",
          "2.9"
        ]
      },
      {
        "path": "docs/test/test-plan-v3.md",
        "sections": [
          "1.4",
          "3"
        ]
      }
    ],
    "gate_commands": [
      "tools/ci.sh"
    ]
  },
  "skills_pass": {
    "runner": "claude",
    "class": "standard",
    "timeout_minutes": 30,
    "enabled": false
  },
  "learning": {
    "gate_commands": [
      "tools/ci.sh --python-only"
    ]
  }
}
